# Docker Compose environment template.
# Copy to .env.docker, fill in values, then run:
#   docker compose --env-file .env.docker up
#
# Hostnames, REST/gRPC ports, Redis, RabbitMQ host/port, OAuth URLs,
# gRPC targets, and per-service database URLs are configured in docker-compose.yml.

# Infrastructure (host-exposed ports and container credentials)
LOKIT_NGINX_PORT=
LOKIT_NGINX_HOST=
LOKIT_KEYCLOAK_PORT=
LOKIT_KEYCLOAK_ADMIN_USERNAME=
LOKIT_KEYCLOAK_ADMIN_PASSWORD=
LOKIT_RABBIT_PANEL_PORT=
LOKIT_RABBITMQ_USERNAME=
LOKIT_RABBITMQ_PASSWORD=

# PostgreSQL (shared credentials; databases created by init script)
LOKIT_POSTGRES_USERNAME=
LOKIT_POSTGRES_PASSWORD=

# Mosquitto
LOKIT_MOSQUITTO_ADMIN_USERNAME=
LOKIT_MOSQUITTO_ADMIN_PASSWORD=

# Auth
# Public URL used in browser to reach Keycloak (must match JWT iss claim)
LOKIT_KEYCLOAK_PUBLIC_URL=
LOKIT_KEYCLOAK_REALM=
LOKIT_KEYCLOAK_CLIENT_ID=
LOKIT_KEYCLOAK_CLIENT_SECRET=
LOKIT_JWT_ROLE_CLAIMS=

# TLS keystore passwords (must match generated .p12 files)
LOKIT_IDENTITY_TLS_SERVER_KEYSTORE_PASSWORD=
LOKIT_IDENTITY_TLS_SERVER_TRUSTSTORE_PASSWORD=

LOKIT_ROLE_TLS_SERVER_KEYSTORE_PASSWORD=
LOKIT_ROLE_TLS_SERVER_TRUSTSTORE_PASSWORD=
LOKIT_ROLE_TLS_CLIENT_KEYSTORE_PASSWORD=
LOKIT_ROLE_TLS_CLIENT_TRUSTSTORE_PASSWORD=

LOKIT_ROOM_TLS_SERVER_KEYSTORE_PASSWORD=
LOKIT_ROOM_TLS_SERVER_TRUSTSTORE_PASSWORD=
LOKIT_ROOM_TLS_CLIENT_KEYSTORE_PASSWORD=
LOKIT_ROOM_TLS_CLIENT_TRUSTSTORE_PASSWORD=

LOKIT_CARD_TLS_SERVER_KEYSTORE_PASSWORD=
LOKIT_CARD_TLS_SERVER_TRUSTSTORE_PASSWORD=
LOKIT_CARD_TLS_CLIENT_KEYSTORE_PASSWORD=
LOKIT_CARD_TLS_CLIENT_TRUSTSTORE_PASSWORD=

LOKIT_DEVICE_TLS_SERVER_KEYSTORE_PASSWORD=
LOKIT_DEVICE_TLS_SERVER_TRUSTSTORE_PASSWORD=
LOKIT_DEVICE_TLS_CLIENT_KEYSTORE_PASSWORD=
LOKIT_DEVICE_TLS_CLIENT_TRUSTSTORE_PASSWORD=
LOKIT_DEVICE_MQTT_CLIENT_ID=
LOKIT_DEVICE_MQTT_USERNAME=
LOKIT_DEVICE_MQTT_PASSWORD=

LOKIT_DECISION_TLS_CLIENT_KEYSTORE_PASSWORD=
LOKIT_DECISION_TLS_CLIENT_TRUSTSTORE_PASSWORD=
